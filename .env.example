# 复制本文件为 .env，填入真实值后使用（.env 已在 .gitignore 中，不会入库）

# PostgreSQL 连接串
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable

# 监听地址（生产环境建议 127.0.0.1，由 nginx 反向代理）
HOST=127.0.0.1
PORT=2690
DEBUG=0

# 服务标识（/api/v1/health 会返回）
SERVICE_NAME=the-door-of-bings
SERVICE_VERSION=1.1.0

# 连接池
DB_POOL_MIN=1
DB_POOL_MAX=8

# --------------------------------------------------------------------------- #
# 世界状态（玩家列表 / 世界物品列表，WebSocket 实时同步）
# --------------------------------------------------------------------------- #
# 广播节拍：每秒下发几次快照
WORLD_TICK_HZ=10
# 无变化时的心跳间隔（秒），让客户端确认连接还活着
WORLD_HEARTBEAT_SEC=2.0
# 超过这么多秒没有连接记录就清掉（半开连接兜底）
WORLD_STALE_SEC=60.0
# 是否校验「设备 + 用户 ID + 名称」三元组；生产必须为 1，本地自测可改 0
WORLD_REQUIRE_AUTH=1
# 世界物品位置是否落库（需 DATABASE_URL）
WORLD_PERSIST=1
WORLD_FLUSH_SEC=10.0
# 同时在线的最大连接数
WORLD_MAX_CLIENTS=256

# WebSocket 细节
WS_HANDSHAKE_TIMEOUT=10.0
WS_IDLE_TIMEOUT=75.0
WS_MIN_UPDATE_INTERVAL=0.02

