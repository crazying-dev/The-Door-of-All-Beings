# 复制本文件为 .env，填入真实值后使用（.env 已在 .gitignore 中，不会入库）

# --------------------------------------------------------------------------- #
# 存储
# --------------------------------------------------------------------------- #
# PostgreSQL 连接串
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
# postgres（默认）/ memory（本地调试、跑测试，不需要数据库）
DB_BACKEND=postgres
DB_POOL_MIN=1
DB_POOL_MAX=8

# --------------------------------------------------------------------------- #
# 网络
# --------------------------------------------------------------------------- #
# 对外公布的地址与 TCP 端口（只用于 HTTP 发现接口下发，不再参与是否启动的判断）
HOST=127.0.0.1
PORT=5423
# 实际监听地址（生产建议 TCP_BIND=0.0.0.0，HTTP_BIND=127.0.0.1 交给 nginx）
TCP_BIND=0.0.0.0
HTTP_BIND=127.0.0.1
HTTP_PORT=4231

# --------------------------------------------------------------------------- #
# 安全
# --------------------------------------------------------------------------- #
# 设备 ID 的 HMAC 整名密钥，至少 32 字节。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
# ⚠ 定下来就不要改：改了所有老账号都绑不上。
DEVICE_ID_SECRET=
# 设备 ID 有效期（秒），0 = 永不过期
DEVICE_ID_MAX_AGE=0
# 报文时间戳容差（秒）
REQUEST_TIME_WINDOW=300

# --------------------------------------------------------------------------- #
# 运行时
# --------------------------------------------------------------------------- #
DEBUG=0
# 单行最大字节数（device_id 是 1024 字节，hex 后 2048 字符，勿小于 4096）
MAX_LINE_BYTES=16384
# 连接读超时（秒）
READ_TIMEOUT=180
# 最大并发连接数
MAX_CONNECTIONS=256
# 世界快照推送频率（Hz）
PUSH_HZ=10
# 内存数据落库间隔（秒）
AUTOSAVE_INTERVAL=60
# 用户名称最大长度
USER_NAME_MAX_LEN=24

