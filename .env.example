# 复制本文件为 .env，填入真实值后使用（.env 已在 .gitignore 中，不会入库）
#
# 本组件是 HTTP 发现服务：只下发 TCP 游戏服（server-socket 组件）的地址，
# 不连数据库、不管设备密钥 —— 那些配置都在 server-socket 组件那边。

# --------------------------------------------------------------------------- #
# 网络
# --------------------------------------------------------------------------- #
# 对外公布的 TCP 游戏服地址与端口（发现接口下发给客户端，
# 必须是客户端能连到的公网地址，改了要重启）
HOST=127.0.0.1
PORT=5423
# HTTP 实际监听地址与端口（生产建议 HTTP_BIND=127.0.0.1 交给 nginx）
HTTP_BIND=127.0.0.1
HTTP_PORT=4231

# --------------------------------------------------------------------------- #
# 运行时
# --------------------------------------------------------------------------- #
DEBUG=0
