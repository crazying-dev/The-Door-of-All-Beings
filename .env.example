# 复制本文件为 .env，填入真实值后使用（.env 已在 .gitignore 中，不会入库）
#
# 本组件是 TCP 游戏协议服务。HTTP 发现接口在独立的 server 组件，
# 那边会重复配置 HOST / PORT（下发给客户端的对外地址），两边要保持一致。

# --------------------------------------------------------------------------- #
# 存储
# --------------------------------------------------------------------------- #
# PostgreSQL 连接串
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
# postgres（默认）/ memory（本地调试、跑测试，不需要数据库）
DB_BACKEND=postgres
DB_POOL_MIN=1
DB_POOL_MAX=8

# --------------------------------------------------------------------------- #
# 网络
# --------------------------------------------------------------------------- #
# 对外公布的地址与 TCP 端口（仅日志与调试直连用；下发给客户端由 server 组件负责，
# 但两边要配成同一个值，客户端才能连对地方）
HOST=127.0.0.1
PORT=5423
# 实际监听地址与端口（生产建议 TCP_BIND=0.0.0.0；TCP_PORT 不写则跟随 PORT）
TCP_BIND=0.0.0.0
#TCP_PORT=5423

# --------------------------------------------------------------------------- #
# 安全
# --------------------------------------------------------------------------- #
# 设备 ID 的 HMAC 整名密钥，至少 32 字节。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
# ⚠ 定下来就不要改：改了所有老账号都绑不上。
DEVICE_ID_SECRET=
# 设备 ID 有效期（秒），0 = 永不过期
DEVICE_ID_MAX_AGE=0
# 报文时间戳容差（秒）
REQUEST_TIME_WINDOW=300

# --------------------------------------------------------------------------- #
# 运行时
# --------------------------------------------------------------------------- #
DEBUG=0
# 单行最大字节数（device_id 是 1024 字节，hex 后 2048 字符，勿小于 4096）
MAX_LINE_BYTES=16384
# 连接读超时（秒）
READ_TIMEOUT=180
# 最大并发连接数
MAX_CONNECTIONS=256
# 世界快照推送频率（Hz）
PUSH_HZ=10
# 内存数据落库间隔（秒）
AUTOSAVE_INTERVAL=60
# 用户名称最大长度
USER_NAME_MAX_LEN=24
# 意外断开后的宽限期（秒）：这段时间内保留玩家热缓存与在线标记，
# 同设备重连可直接接管；超时才落库并销毁 player / 会话 Token（见 flows.md 流程 4）
GRACE_SECONDS=5
