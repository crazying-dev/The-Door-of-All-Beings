# 众生之门 服务端 —— systemd 单元模板
# 使用：cp 到 /etc/systemd/system/the-door-of-bings-http.service
#       systemctl daemon-reload && systemctl enable --now the-door-of-bings-http

[Unit]
Description=The Door of All Beings - HTTP discovery service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=<WORKDIR>
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# 若 uv 不在 PATH 中，改成绝对路径，例如 /root/.local/bin/uv
# 本组件只起 HTTP（默认 4231）；TCP 游戏服是独立的 server-socket 组件
ExecStart=/usr/bin/env uv run main.py serve
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=append:/var/log/the-door-of-bings-http.log
StandardError=append:/var/log/the-door-of-bings-http.log

[Install]
WantedBy=multi-user.target
