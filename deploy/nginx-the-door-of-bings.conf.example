# 众生之门 账号服务 —— nginx 反向代理 + HTTPS 模板
# 使用：cp 到 /etc/nginx/conf.d/the-door-of-bings.conf，替换域名/证书路径后 nginx -t && systemctl reload nginx

upstream thedoor_backend {
    server 127.0.0.1:2690;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name the-door-of-bings.yjlt.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name the-door-of-bings.yjlt.top;

    # certbot --nginx -d the-door-of-bings.yjlt.top 会自动填好下面两行
    ssl_certificate     /etc/letsencrypt/live/the-door-of-bings.yjlt.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/the-door-of-bings.yjlt.top/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/thedoor.access.log;
    error_log  /var/log/nginx/thedoor.error.log;

    # 接口很小，限制体积即可
    client_max_body_size 64k;

    location / {
        proxy_pass http://thedoor_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
