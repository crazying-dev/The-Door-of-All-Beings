# 众生之门 服务端 —— nginx 反向代理 + HTTPS 模板
#
# 拓扑：
#   TCP 游戏协议  直接暴露公网（默认 5423），**不过 nginx**，由 server-socket 组件监听
#   HTTP 发现接口 127.0.0.1:4231（本组件），由本文件反向代理到 https
#
# 使用：cp 到 /etc/nginx/conf.d/the-door-of-bings.conf，
#       替换域名与证书路径后 nginx -t && systemctl reload nginx

upstream thedoor_http {
    server 127.0.0.1:4231;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name the-door-of-bings.yjlt.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name the-door-of-bings.yjlt.top;

    # certbot --nginx -d the-door-of-bings.yjlt.top 会自动填好下面两行
    ssl_certificate     /etc/letsencrypt/live/the-door-of-bings.yjlt.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/the-door-of-bings.yjlt.top/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/thedoor.access.log;
    error_log  /var/log/nginx/thedoor.error.log;

    # 发现接口只有几百字节
    client_max_body_size 64k;

    location / {
        proxy_pass http://thedoor_http;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}

# --------------------------------------------------------------------------- #
# TCP 游戏端口不在 nginx 里代理：nginx 的 stream 模块虽然能转发 TCP，
# 但它会把客户端 IP 换成 127.0.0.1，服务端就拿不到真实来源了。
# 需要时请在云厂商安全组 / ufw 里放行 5423/TCP：
#   ufw allow 5423/tcp
# --------------------------------------------------------------------------- #
